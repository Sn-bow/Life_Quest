rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function hasValidCharacterProgress() {
      return !('character' in request.resource.data)
             || (request.resource.data.character.gold >= 0
                 && request.resource.data.character.level >= 1);
    }

    match /users/{userId} {
      allow read, create, delete: if isOwner(userId);

      allow update: if isOwner(userId) && hasValidCharacterProgress();
    }

    match /users/{userId}/_meta/{doc} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/entitlements/{productId} {
      allow read, delete: if isOwner(userId);
      // Only trusted Cloud Functions grant or revoke paid content.
      allow create, update: if false;
    }

    match /users/{userId}/aiReports/{reportId} {
      allow read, delete: if isOwner(userId);
      allow create: if isOwner(userId)
          && request.resource.data.keys().hasOnly(['schema', 'model', 'title', 'instruction', 'reason', 'locale', 'reportedAt'])
          && request.resource.data.schema == 1
          && request.resource.data.model == 'gemma-4-e2b'
          && request.resource.data.title is string && request.resource.data.title.size() <= 100
          && request.resource.data.instruction is string && request.resource.data.instruction.size() <= 320
          && request.resource.data.reason is string && request.resource.data.reason.size() <= 240
          && request.resource.data.locale in ['ko', 'en', 'ja', 'zh']
          && request.resource.data.reportedAt == request.time;
      allow update: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
