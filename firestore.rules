rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isActiveOwner(userId) {
      return isOwner(userId) && !exists(/databases/$(database)/documents/accountDeletions/$(userId));
    }

    function hasValidCharacterProgress() {
      return !('character' in request.resource.data)
             || (request.resource.data.character.gold >= 0
                 && request.resource.data.character.level >= 1);
    }

    match /users/{userId} {
      allow read: if isActiveOwner(userId);
      allow delete: if false; // Request coordinated deletion through the callable.
      allow create: if isActiveOwner(userId) && hasValidCharacterProgress()
          && !request.resource.data.keys().hasAny(['deletionPending', 'accountKind']);

      allow update: if isActiveOwner(userId) && hasValidCharacterProgress()
          && resource.data.get('accountKind', '') != 'purchaseOnly'
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['deletionPending', 'accountKind']);
    }

    match /users/{userId}/_meta/{doc} {
      allow read, write: if isActiveOwner(userId);
    }

    match /users/{userId}/entitlements/{productId} {
      allow read: if isActiveOwner(userId);
      // Only trusted Cloud Functions grant or revoke paid content.
      allow create, update, delete: if false;
    }

    match /users/{userId}/aiReports/{reportId} {
      allow read, delete: if isActiveOwner(userId);
      // Callable owns validation, idempotence, quota and the retention clock.
      allow create, update: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
