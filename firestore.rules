rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isActiveOwner(userId) {
      return isOwner(userId) && !exists(/databases/$(database)/documents/accountDeletions/$(userId));
    }

    function hasValidCharacterProgress() {
      return !('character' in request.resource.data)
             || (request.resource.data.character.gold >= 0
                 && request.resource.data.character.level >= 1);
    }

    match /users/{userId} {
      allow read: if isActiveOwner(userId);
      allow delete: if false; // Request coordinated deletion through the callable.
      allow create: if isActiveOwner(userId) && hasValidCharacterProgress()
          && !('deletionPending' in request.resource.data);

      allow update: if isActiveOwner(userId) && hasValidCharacterProgress()
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['deletionPending']);
    }

    match /users/{userId}/_meta/{doc} {
      allow read, write: if isActiveOwner(userId);
    }

    match /users/{userId}/entitlements/{productId} {
      allow read: if isActiveOwner(userId);
      // Only trusted Cloud Functions grant or revoke paid content.
      allow create, update, delete: if false;
    }

    match /users/{userId}/aiReports/{reportId} {
      allow read, delete: if isActiveOwner(userId);
      allow create: if isActiveOwner(userId)
          && request.resource.data.keys().hasOnly(['schema', 'model', 'title', 'instruction', 'reason', 'locale', 'reportedAt'])
          && request.resource.data.schema == 1
          && request.resource.data.model == 'gemma-4-e2b'
          && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 100
          && request.resource.data.instruction is string && request.resource.data.instruction.size() > 0 && request.resource.data.instruction.size() <= 320
          && request.resource.data.reason is string && request.resource.data.reason.size() > 0 && request.resource.data.reason.size() <= 240
          && request.resource.data.locale in ['ko', 'en', 'ja', 'zh']
          && request.resource.data.reportedAt == request.time;
      allow update: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
